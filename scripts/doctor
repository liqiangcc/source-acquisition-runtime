#!/usr/bin/env bash
set -euo pipefail

fail=0
check_takeover=0
check_mcp=0
check_gateway=0
check_navigate_timeout=0
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
pass() { printf '[PASS] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*"; }
fail_check() { printf '[FAIL] %s\n' "$*"; fail=1; }

for arg in "$@"; do
  case "$arg" in
    --human-takeover) check_takeover=1 ;;
    --mcp-smoke) check_mcp=1 ;;
    --gateway) check_gateway=1 ;;
    --navigate-timeout) check_navigate_timeout=1 ;;
    *) echo "ERROR: unknown argument: $arg" >&2; exit 2 ;;
  esac
done

if command -v google-chrome-stable >/dev/null 2>&1; then
  pass "Chrome installed: $(google-chrome-stable --version)"
else
  fail_check "Chrome installed"
fi

for unit in source-xvfb.service source-chrome.service; do
  if systemctl is-active --quiet "$unit"; then pass "$unit active"; else fail_check "$unit active"; fi
done

profile=/var/lib/source-acquisition-runtime/chrome-profile
if [[ -d "$profile" ]]; then
  owner="$(stat -c '%U:%G' "$profile")"
  mode="$(stat -c '%a' "$profile")"
  [[ "$owner" == 'source-runtime:source-runtime' ]] && pass "dedicated profile owner $owner" || fail_check "profile owner is $owner"
  [[ "$mode" == '700' ]] && pass "dedicated profile mode 700" || warn "profile mode is $mode"
else
  fail_check "dedicated profile exists"
fi

listeners="$(ss -H -ltn 'sport = :9222' | awk '{print $4}' || true)"
if [[ -z "$listeners" ]]; then
  fail_check "CDP listener exists"
elif printf '%s\n' "$listeners" | grep -Eqv '^(127\.0\.0\.1|\[::1\]):9222$'; then
  fail_check "CDP listener is localhost-only; observed: $listeners"
else
  pass "CDP localhost-only: $(printf '%s' "$listeners" | tr '\n' ' ')"
fi

if curl -fsS --max-time 2 http://127.0.0.1:9222/json/version >/dev/null 2>&1; then
  pass "CDP reachable on localhost"
else
  fail_check "CDP reachable on localhost"
fi

x11_active=0
novnc_active=0
systemctl is-active --quiet source-x11vnc.service 2>/dev/null && x11_active=1 || true
systemctl is-active --quiet source-novnc.service 2>/dev/null && novnc_active=1 || true

if [[ "$check_takeover" -eq 1 || "$x11_active" -eq 1 || "$novnc_active" -eq 1 ]]; then
  [[ "$x11_active" -eq 1 ]] && pass "source-x11vnc.service active" || fail_check "source-x11vnc.service active"
  [[ "$novnc_active" -eq 1 ]] && pass "source-novnc.service active" || fail_check "source-novnc.service active"

  vnc_listeners="$(ss -H -ltn 'sport = :5900' | awk '{print $4}' || true)"
  if [[ -z "$vnc_listeners" ]]; then
    fail_check "VNC loopback listener exists"
  elif printf '%s\n' "$vnc_listeners" | grep -Eqv '^(127\.0\.0\.1|\[::1\]):5900$'; then
    fail_check "VNC listener is loopback-only; observed: $vnc_listeners"
  else
    pass "VNC loopback-only: $(printf '%s' "$vnc_listeners" | tr '\n' ' ')"
  fi

  takeover_ip="$(ip -4 -o addr show dev tailscale0 scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
  novnc_listeners="$(ss -H -ltn 'sport = :6080' | awk '{print $4}' || true)"
  if [[ -z "$takeover_ip" ]]; then
    fail_check "tailscale0 IPv4 exists for human takeover"
  elif [[ "$novnc_listeners" == "$takeover_ip:6080" ]]; then
    pass "noVNC tailnet-only: $novnc_listeners"
    if curl --noproxy '*' -fsS --max-time 2 "http://$takeover_ip:6080/vnc.html" >/dev/null 2>&1; then
      pass "noVNC page reachable on tailnet address"
    else
      fail_check "noVNC page reachable on tailnet address"
    fi
  else
    fail_check "noVNC listener matches tailnet address; observed: $novnc_listeners expected: $takeover_ip:6080"
  fi
else
  takeover_listeners="$(ss -H -ltn | grep -E ':(5900|6080)\b' || true)"
  if [[ -z "$takeover_listeners" ]]; then
    pass "human takeover inactive by default; no :5900/:6080 listeners"
  else
    fail_check "human takeover services inactive but listeners remain: $takeover_listeners"
  fi
fi

mcp_root=/opt/source-acquisition-runtime/chrome-devtools-mcp
if [[ -f "$mcp_root/node_modules/chrome-devtools-mcp/package.json" ]]; then
  version="$(node -p "require('$mcp_root/node_modules/chrome-devtools-mcp/package.json').version")"
  pass "chrome-devtools-mcp installed: $version"
  if node "$script_dir/../deploy/chrome-devtools-mcp/apply-compat-patches.mjs" --check "$mcp_root" >/dev/null; then
    pass "chrome-devtools-mcp navigate timeout compatibility patch"
  else
    fail_check "chrome-devtools-mcp navigate timeout compatibility patch"
  fi
else
  warn "chrome-devtools-mcp not installed yet"
fi

if [[ "$check_mcp" -eq 1 ]]; then
  if node "$mcp_root/mcp-smoke.mjs"; then pass "MCP smoke"; else fail_check "MCP smoke"; fi
fi

if [[ "$check_navigate_timeout" -eq 1 ]]; then
  if node "$script_dir/navigate-timeout-smoke.mjs"; then
    pass "navigate timeout false-negative regression"
  else
    fail_check "navigate timeout false-negative regression"
  fi
fi

if [[ "$check_gateway" -eq 1 ]]; then
  if systemctl is-active --quiet source-mcp-gateway.service; then
    pass "source-mcp-gateway.service active"
  else
    fail_check "source-mcp-gateway.service active"
  fi

  gateway_listeners="$(ss -H -ltn 'sport = :8765' | awk '{print $4}' || true)"
  if [[ "$gateway_listeners" == '127.0.0.1:8765' ]]; then
    pass "MCP gateway localhost-only: $gateway_listeners"
  else
    fail_check "MCP gateway listener must be exactly 127.0.0.1:8765; observed: $gateway_listeners"
  fi

  if curl -fsS --max-time 2 http://127.0.0.1:8765/_healthz >/dev/null 2>&1; then
    pass "MCP gateway health"
  else
    fail_check "MCP gateway health"
  fi

  if curl -fsS --max-time 2 http://127.0.0.1:8765/_readyz >/dev/null 2>&1; then
    pass "MCP gateway downstream ready"
  else
    fail_check "MCP gateway downstream ready"
  fi

  if node "$script_dir/gateway-smoke.mjs"; then
    pass "MCP gateway Streamable HTTP smoke"
  else
    fail_check "MCP gateway Streamable HTTP smoke"
  fi
fi

exit "$fail"
